{
  "expo": {
    "name": "Bago",
    "slug": "bolt-expo-nativewind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#5845D8"
    },
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deracali.boltexponativewind",
      "buildNumber": "14",
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#5845D8"
      },
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "20 20 12 61 79 80 81 98 33 100 204 250 395 398 399 400 701GOOGLE_IOS_REVERSED_CLIENT_ID)"
            ]
          }
        ],
        "NSUserTrackingUsageDescription": "This identifier will be used to send you personalized notifications.",
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to detect your country and currency",
        "NSCameraUsageDescription": "This app needs access to your camera to scan QR codes and take photos",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select images",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.deracali.boltexponativewind",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "usesCleartextTraffic": true,
      "notification": {
        "icon": "./assets/images/icon.png",
        "color": "#6366F1",
        "priority": "max",
        "channelId": "default"
      }
    },
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#6366F1",
      "iosDisplayInForeground": true
    },
    "permissions": {
      "location": {
        "ios": {
          "description": "Allow the app to access your location to provide personalized services."
        },
        "android": {
          "description": "Allow the app to access your location to provide personalized services."
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#6366F1",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Bago to use your location to detect your country and currency."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f59f4175-ebfc-441c-a1f0-da6e6456dd1f"
      },
      "googleClientId": "your_google_web_client_id",
      "iosGoogleClientId": "your_google_ios_client_id",
      "androidGoogleClientId": "your_google_android_client_id"
    },
    "owner": "donnyace"
  }
}
