# MIME types — must come before rewrite rules
AddType image/svg+xml .svg
AddType image/svg+xml .svgz
AddType text/javascript .js
AddType text/css .css

# iOS Universal Links verification file has no extension — force its type
# so Apple's CDN fetch doesn't choke on octet-stream.
<Files "apple-app-site-association">
  ForceType application/json
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Serve .well-known files directly (Apple Pay domain verification)
  RewriteRule ^\.well-known/ - [L]

  # 3. Never rewrite real asset requests to index.html.
  # Missing JS/CSS/images should return 404 instead of HTML-as-JavaScript.
  RewriteRule ^assets/ - [L]
  RewriteRule \.(js|css|png|jpg|jpeg|gif|svg|webp|ico|json|map|txt|xml|woff2?|ttf|otf)$ - [L]

  # 4. SPA Routing - Handle Refreshes (login, dashboard, etc)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
