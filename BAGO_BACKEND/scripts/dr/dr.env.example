# Copy these names into GitHub Actions or your secret manager. Never commit values.
SUPABASE_DB_URL=postgresql://user:password@host:5432/database
SUPABASE_URL=https://project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Restic encrypts every snapshot before it leaves the runner.
RESTIC_REPOSITORY=s3:https://<account>.r2.cloudflarestorage.com/bago-dr
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Optional controls
DR_INCLUDE_SUPABASE_STORAGE=true
DR_INCLUDE_CLOUDINARY=true
DR_SUPABASE_BUCKETS=
# Empty means every asset in the dedicated Cloudinary product environment.
DR_CLOUDINARY_PREFIX=
DR_HEALTHCHECK_URL=
